{
  "kind": "collectionType",
  "collectionName": "solutions",
  "info": {
    "singularName": "solution",
    "pluralName": "solutions",
    "displayName": "Solution"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "enumeration",
      "enum": [
        "residential",
        "commercial",
        "industrial"
      ],
      "required": true,
      "unique": true
    },
    "hero": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "summary": {
      "type": "text"
    },
    "benefits": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "idealFor": {
      "type": "json"
    },
    "typicalSize": {
      "type": "string"
    },
    "savingsRange": {
      "type": "string"
    },
    "faqs": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::faq.faq"
    },
    "tag": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sizeMeter": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "metricLabel": {
      "type": "string"
    },
    "metricValue": {
      "type": "string"
    },
    "metricMeter": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "caption": {
      "type": "string"
    }
  }
}
