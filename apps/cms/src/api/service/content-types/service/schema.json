{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "systems",
        "installation",
        "specialty"
      ],
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "blocks"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.feature-item"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "details": {
      "type": "json"
    }
  }
}
