{
  "kind": "collectionType",
  "collectionName": "add_ons",
  "info": {
    "singularName": "add-on",
    "pluralName": "add-ons",
    "displayName": "Add-on",
    "description": "Extras a customer can add to a package (battery module, panels, EV charger…). Leave price empty for \"Ask for price\"."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "spec": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "price": {
      "type": "integer"
    },
    "priceFrom": {
      "type": "boolean",
      "default": false
    },
    "unit": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
