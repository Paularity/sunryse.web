HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- SunRyse additions (no real secrets) ---
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# Public site URL (for CORS / webhooks)
PUBLIC_URL=http://localhost:1337
# Web app revalidate webhook (set in Strapi admin webhook; secret must match apps/web REVALIDATE_SECRET)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
WEB_REVALIDATE_SECRET=changeme
# The website's API token (read content + create/update leads) is created by `pnpm setup` locally, or by hand in a
# production admin: `PRINT_PERMISSIONS=1 pnpm --filter cms setup:web` lists what to tick. apps/web uses it as STRAPI_TOKEN.

# --- Production (see docs/DEPLOY-PLAN.md) ---
# NODE_ENV=production
# PUBLIC_URL=https://cms.example.com
# IS_PROXIED=true                      # behind the host's proxy (Railway): trust its forwarded headers
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/strapi
# DATABASE_SSL=true
# Media on Cloudinary (leave unset to keep uploads on local disk)
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
