# Copy to .env.local for local work (`pnpm setup` writes the Strapi values for you). No real secrets here.

# Strapi (CMS). Without STRAPI_URL the site renders the bundled defaults in /content.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
# Shared with the CMS's WEB_REVALIDATE_SECRET; the Strapi webhook sends it to /api/revalidate.
REVALIDATE_SECRET=
# Public address of the site (sitemap, robots, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production media: the Cloudinary account the CMS uploads to (allows next/image to load only its images).
# CLOUDINARY_CLOUD_NAME=

# New-lead emails via Resend (all three needed; off when any is missing).
# RESEND_API_KEY=
# LEAD_NOTIFY_TO=sales@example.com
# LEAD_NOTIFY_FROM="SunRyse Website <leads@example.com>"
